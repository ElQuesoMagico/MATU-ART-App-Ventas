// D4 candidate. Immutable operations connect one sale and all of its inventory effects.
function saleEffect(r,n) {
  let id=r.sale.items[n].productId;
  return getAfter(/databases/$(database)/documents/workspaces/$(w)/inventory/$(id)).data.balance==r.after[id];
}
function saleInventory(d,id) {
  let r=d.receipt;
  let items=r.sale.items;
  let n=items[0].productId==id?0:(items.size()>1 && items[1].productId==id?1:(items.size()>2 && items[2].productId==id?2:(items.size()>3 && items[3].productId==id?3:4)));
  return d.kind=='sale'?saleLine(r,n):d.kind=='void' && voidLine(r,get(/databases/$(database)/documents/workspaces/$(w)/sharedSales/$(r.intent.saleId)).data.sale,n);
}
function saleOpId(d) { return d.kind=='sale'?d.receipt.intent.sale.operationId:d.receipt.intent.operationId; }
function saleLine(r,n) {
  let i=r.sale.items[n];
  let b=r.before[i.productId];
  let a=r.after[i.productId];
  let m=r.movements[n];
  return uuid(i.productId) && i.quantity is int && i.quantity>0 && i.unitPrice is int && i.unitPrice>=0
    && i.lineTotal==i.quantity*i.unitPrice && !b.countPending
    && a.keys().toSet()==b.keys().toSet() && a.productId==i.productId && invInteger(a.stock) && a.revision==b.revision+1 && a.operationId==r.sale.operationId
    && a.countPending==false && i.stock.previousStock==b.stock && i.stock.quantitySold==i.quantity
    && i.stock.quantityDeducted==(b.stock<=0?0:(i.quantity<b.stock?i.quantity:b.stock))
    && i.stock.uncoveredQuantity==i.quantity-i.stock.quantityDeducted && a.stock==b.stock-i.stock.quantityDeducted
    && i.stock.resultingStock==a.stock && a.costs.averageCost==b.costs.averageCost
    && a.costs.lastKnownCost==b.costs.lastKnownCost && a.costs.estimatedUnitCost==b.costs.estimatedUnitCost
    && a.costs.averageCostIsProvisional==(b.costs.averageCostIsProvisional || a.stock<=0)
    && m.id==r.sale.movementIds[n] && uuid(m.id) && m.productId==i.productId && m.saleId==r.sale.id && m.type=='sale'
    && m.sharedOperationId==r.sale.operationId && m.actorUid==request.auth.uid && m.sharedStatus=='confirmed'
    && m.quantityChange==0-i.stock.quantityDeducted && m.previousStock==b.stock && m.resultingStock==a.stock
    && m.requestedQuantity==i.quantity && m.uncoveredQuantity==i.stock.uncoveredQuantity
    && get(/databases/$(database)/documents/workspaces/$(w)/inventory/$(i.productId)).data.balance==b
    && getAfter(/databases/$(database)/documents/workspaces/$(w)/inventory/$(i.productId)).data.balance==a;
}
function salePayment(s,n) {
  let p=s.payments[n];
  return uuid(p.id) && p.saleId==s.id && p.method in ['cash','transfer','debit'] && p.amount is int && p.amount>=0;
}
function newSharedSale(r) {
  let s=r.sale;
  let count=s.items.size();
  return uuid(s.id) && uuid(s.operationId) && s.status=='completed' && !('voidAudit' in s) && !('historicalSource' in s)
    && s.sharedActorUid==request.auth.uid && s.deviceId==r.intent.deviceId
    && s.number is int && s.number>0 && s.items is list && count>0 && count<=5
    && r.movements.size()==count && s.movementIds.size()==count && s.movementIds.toSet().size()==count
    && r.before.size()==count && r.after.size()==count
    && s.subtotal is int && s.subtotal>=0 && s.discount is int && s.discount>=0 && s.total==s.subtotal-s.discount && s.total>=0
    && s.payments is list && s.payments.size()<=3
    && (s.payments.size()<1||salePayment(s,0)) && (s.payments.size()<2||salePayment(s,1)) && (s.payments.size()<3||salePayment(s,2))
    && s.total==(s.payments.size()>0?s.payments[0].amount:0)+(s.payments.size()>1?s.payments[1].amount:0)+(s.payments.size()>2?s.payments[2].amount:0)
    && s.subtotal==s.items[0].lineTotal+(count>1?s.items[1].lineTotal:0)+(count>2?s.items[2].lineTotal:0)+(count>3?s.items[3].lineTotal:0)+(count>4?s.items[4].lineTotal:0)
    && saleEffect(r,0) && (count<2||saleEffect(r,1)) && (count<3||saleEffect(r,2)) && (count<4||saleEffect(r,3)) && (count<5||saleEffect(r,4));
}
function voidLine(r,old,n) {
  let i=old.items[n];
  let b=r.before[i.productId];
  let a=r.after[i.productId];
  let m=r.movements[n];
  return !b.countPending && a.keys().toSet()==b.keys().toSet() && a.productId==i.productId && invInteger(a.stock)
    && a.revision==b.revision+1 && a.operationId==r.intent.operationId && !a.countPending
    && a.stock==b.stock+i.stock.quantityDeducted
    && a.costs.averageCost==b.costs.averageCost && a.costs.lastKnownCost==b.costs.lastKnownCost
    && a.costs.estimatedUnitCost==b.costs.estimatedUnitCost
    && a.costs.averageCostIsProvisional==(b.costs.averageCostIsProvisional || i.stock.quantityDeducted>0)
    && m.id==r.intent.movementIds[n] && uuid(m.id) && m.productId==i.productId && m.saleId==old.id && m.type=='sale_void'
    && m.sharedOperationId==r.intent.operationId && m.actorUid==request.auth.uid && m.sharedStatus=='confirmed'
    && m.previousStock==b.stock && m.resultingStock==a.stock && m.quantityChange==i.stock.quantityDeducted && m.requestedQuantity==i.stock.quantityDeducted
    && get(/databases/$(database)/documents/workspaces/$(w)/inventory/$(i.productId)).data.balance==b
    && getAfter(/databases/$(database)/documents/workspaces/$(w)/inventory/$(i.productId)).data.balance==a;
}
function validSharedVoid(r) {
  let old=get(/databases/$(database)/documents/workspaces/$(w)/sharedSales/$(r.intent.saleId)).data.sale;
  let count=old.items.size();
  return editor(w) && old.status=='completed' && r.sale.id==old.id && r.sale.status=='voided'
    && r.sale.diff(old).affectedKeys().hasOnly(['status','voidAudit','voidActorUid'])
    && r.sale.voidActorUid==request.auth.uid
    && r.intent.reason is string && r.intent.reason.size()>0 && r.intent.reason.size()<=500 && r.intent.returnStock is bool
    && r.sale.voidAudit=={'operationId':r.intent.operationId,'reason':r.intent.reason,'returnStock':r.intent.returnStock,'voidedAt':r.intent.occurredAt,'movementIds':r.intent.movementIds}
    && (r.intent.returnStock
      ? count<=5 && r.before.size()==count && r.after.size()==count && r.movements.size()==count && r.intent.movementIds.size()==count && r.intent.movementIds.toSet().size()==count
        && saleEffect(r,0) && (count<2||saleEffect(r,1)) && (count<3||saleEffect(r,2)) && (count<4||saleEffect(r,3)) && (count<5||saleEffect(r,4))
      : r.before.size()==0 && r.after.size()==0 && r.movements.size()==0 && r.intent.movementIds.size()==0);
}
match /saleOperations/{op} {
  allow read: if member(w);
  allow create: if member(w) && request.resource.data.keys().hasOnly(['kind','receipt','confirmedAt'])
    && request.resource.data.confirmedAt==request.time && uuid(op) && saleOpId(request.resource.data)==op
    && request.resource.data.receipt.intent.schemaVersion==1 && request.resource.data.receipt.intent.actorUid==request.auth.uid && uuid(request.resource.data.receipt.intent.deviceId)
    && (request.resource.data.kind=='sale'?newSharedSale(request.resource.data.receipt):request.resource.data.kind=='void' && validSharedVoid(request.resource.data.receipt))
    && getAfter(/databases/$(database)/documents/workspaces/$(w)/sharedSales/$(request.resource.data.receipt.sale.id)).data.sale==request.resource.data.receipt.sale
    && getAfter(/databases/$(database)/documents/workspaces/$(w)/sharedSales/$(request.resource.data.receipt.sale.id)).data.operationId==op;
}
match /sharedSales/{id} {
  allow read: if member(w);
  allow create, update: if member(w) && request.resource.data.keys().hasOnly(['sale','operationId','actorUid','deviceId','confirmedAt'])
    && request.resource.data.sale.id==id && request.resource.data.actorUid==request.auth.uid && request.resource.data.confirmedAt==request.time
    && !exists(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.operationId))
    && getAfter(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.operationId)).data.receipt.sale==request.resource.data.sale
    && (exists(/databases/$(database)/documents/workspaces/$(w)/sharedSales/$(id))
      ? resource.data.sale.status=='completed' && getAfter(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.operationId)).data.kind=='void'
      : getAfter(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.operationId)).data.kind=='sale');
}
match /inventory/{id} {
  allow update: if member(w) && request.resource.data.keys().hasOnly(['balance','confirmedAt']) && request.resource.data.confirmedAt==request.time
    && !exists(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.balance.operationId))
    && getAfter(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.balance.operationId)).data.receipt.after[id]==request.resource.data.balance
    && saleInventory(getAfter(/databases/$(database)/documents/workspaces/$(w)/saleOperations/$(request.resource.data.balance.operationId)).data,id);
}

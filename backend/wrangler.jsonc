{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matu-art-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "https://matu.example.com",
    "GAS_URL": "",
    "GAS_KEY_ID": "v1"
  },
  "d1_databases": [{"binding":"DB","database_name":"matu-art-auth","database_id":"REPLACE_WITH_D1_ID","migrations_dir":"migrations"}],
  "triggers": {"crons":["17 * * * *"]},
  "observability": {"enabled":false}
}

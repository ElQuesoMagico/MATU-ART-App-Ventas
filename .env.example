# Vacío: solo operación local. Producción: /api en el MISMO origen HTTPS.
# Desarrollo: http://localhost:8787/api (usar localhost en ambos servicios).
VITE_CLOUD_API_URL=

# Public Firebase web configuration. Never include passwords/private keys.
# Leave all empty to disable Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_WORKSPACE_ID=
# Enable only after catalog rules and two-device verification, never by default.
VITE_FIREBASE_CATALOG_ENABLED=false
